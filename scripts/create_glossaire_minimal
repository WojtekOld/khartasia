<?php

use Drupal\views\Entity\View;

/**
 * Crée une vue glossaire minimale pour les plantes.
 * Aucun filtre de langue, aucun regroupement.
 */

$view_id = 'glossaire_plantes';
$bundle = 'article';
$chemin = 'glossaire/plantes';

if (View::load($view_id)) {
  View::load($view_id)->delete();
}

$fields = [
  'title' => [
    'id' => 'title',
    'table' => 'node_field_data',
    'field' => 'title',
    'relationship' => 'none',
    'group_type' => 'group',
    'admin_label' => '',
    'label' => '',
    'exclude' => FALSE,
    'alter' => ['alter_text' => FALSE],
    'element_type' => '',
    'element_class' => '',
    'element_label_type' => '',
    'element_label_class' => '',
    'element_label_colon' => FALSE,
    'element_wrapper_type' => '',
    'element_wrapper_class' => '',
    'element_default_classes' => TRUE,
    'empty' => '',
    'hide_empty' => FALSE,
    'empty_zero' => FALSE,
    'hide_alter_empty' => TRUE,
    'plugin_id' => 'node',
    'entity_type' => 'node',
    'entity_field' => 'title',
    'type' => 'string',
    'settings' => ['link_to_entity' => TRUE],
  ],
];

$filters = [
  'status' => [
    'id' => 'status',
    'table' => 'node_field_data',
    'field' => 'status',
    'value' => '1',
    'group' => 1,
    'plugin_id' => 'boolean',
    'entity_type' => 'node',
    'entity_field' => 'status',
  ],
  'type' => [
    'id' => 'type',
    'table' => 'node_field_data',
    'field' => 'type',
    'value' => [$bundle => $bundle],
    'group' => 1,
    'plugin_id' => 'bundle',
    'entity_type' => 'node',
    'entity_field' => 'type',
  ],
];

$sorts = [
  'title' => [
    'id' => 'title',
    'table' => 'node_field_data',
    'field' => 'title',
    'order' => 'ASC',
    'plugin_id' => 'standard',
    'entity_type' => 'node',
    'entity_field' => 'title',
  ],
];

$view = View::create([
  'id' => $view_id,
  'label' => 'Glossaire — Plantes (minimal)',
  'module' => 'views',
  'base_table' => 'node_field_data',
  'base_field' => 'nid',
  'status' => TRUE,
  'display' => [
    'default' => [
      'id' => 'default',
      'display_title' => 'Master',
      'display_plugin' => 'default',
      'position' => 0,
      'display_options' => [
        'fields' => $fields,
        'pager' => [
          'type' => 'full',
          'options' => [
            'items_per_page' => 50,
            'offset' => 0,
            'id' => 0,
            'total_pages' => NULL,
            'expose' => ['items_per_page' => FALSE, 'offset' => FALSE],
            'tags' => ['next' => 'Suivant ›', 'previous' => '‹ Précédent', 'first' => '« Premier', 'last' => 'Dernier »'],
          ],
        ],
        'exposed_form' => ['type' => 'basic', 'options' => ['submit_button' => 'Filtrer']],
        'access' => ['type' => 'perm', 'options' => ['perm' => 'access content']],
        'cache' => ['type' => 'tag', 'options' => []],
        'query' => ['type' => 'views_query', 'options' => ['distinct' => TRUE]],
        'style' => ['type' => 'default', 'options' => []],
        'row' => ['type' => 'fields'],
        'filters' => $filters,
        'sorts' => $sorts,
      ],
      'cache_metadata' => ['max-age' => -1, 'contexts' => ['url.query_args'], 'tags' => []],
    ],
    'page_1' => [
      'id' => 'page_1',
      'display_title' => 'Page',
      'display_plugin' => 'page',
      'position' => 1,
      'display_options' => [
        'path' => $chemin,
        'display_extenders' => [],
      ],
      'cache_metadata' => ['max-age' => -1, 'contexts' => ['url.query_args'], 'tags' => []],
    ],
  ],
]);
$view->save();
drupal_flush_all_caches();
\Drupal::service('router.builder')->rebuild();
echo "Vue minimale créée.\n";