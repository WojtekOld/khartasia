<?php

/**
 * @file
 * Contains module file.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ui_styles_entity_status\Hook\UiStylesEntityStatusHooks;

/**
 * Implements hook_entity_view().
 */
#[LegacyHook]
function ui_styles_entity_status_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  \Drupal::service(UiStylesEntityStatusHooks::class)->entityView($build, $entity, $display, $view_mode);
}

/**
 * Implements hook_form_FORM_ID_alter() for 'system_theme_settings'.
 */
#[LegacyHook]
function ui_styles_entity_status_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(UiStylesEntityStatusHooks::class)->formSystemThemeSettingsAlter($form, $form_state);
}
