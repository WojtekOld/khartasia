<?php

/**
 * @file
 * Contains module file.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ui_styles_library\Hook\UiStylesLibraryHooks;

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function ui_styles_library_theme(): array {
  return \Drupal::service(UiStylesLibraryHooks::class)->theme();
}
