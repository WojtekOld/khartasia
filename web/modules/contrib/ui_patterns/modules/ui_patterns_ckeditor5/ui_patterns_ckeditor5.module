<?php

/**
 * @file
 * Gives the embedded components the entity their text belongs to.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ui_patterns_ckeditor5\Hook\UiPatternsCkeditor5Hooks;

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
#[LegacyHook]
function ui_patterns_ckeditor5_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  Drupal::service(UiPatternsCkeditor5Hooks::class)->fieldWidgetSingleElementFormAlter($element, $form_state, $context);
}

/**
 * Implements hook_entity_display_build_alter().
 */
#[LegacyHook]
function ui_patterns_ckeditor5_entity_display_build_alter(array &$build, array $context): void {
  Drupal::service(UiPatternsCkeditor5Hooks::class)->entityDisplayBuildAlter($build, $context);
}

/**
 * Implements hook_ui_patterns_form_alter().
 */
#[LegacyHook]
function ui_patterns_ckeditor5_ui_patterns_form_alter(array &$form, FormStateInterface $form_state): void {
  Drupal::service(UiPatternsCkeditor5Hooks::class)->uiPatternsFormAlter($form, $form_state);
}

/**
 * Implements hook_ui_patterns_component_pre_build_alter().
 */
#[LegacyHook]
function ui_patterns_ckeditor5_ui_patterns_component_pre_build_alter(array &$element): void {
  Drupal::service(UiPatternsCkeditor5Hooks::class)->uiPatternsComponentPreBuildAlter($element);
}
