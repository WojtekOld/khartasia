# Reporter level: error, warn, info, http, verbose, debug, silly
PLAYWRIGHT_DEBUG_LEVEL='info'

## Uncomment the section you need.

##
# Case 1: Web server only, no database service (SQLite), no Drupal installation.
#
# Tests will install Drupal (like CI) and create a simpletest environment.
# Your settings.php MUST include:
# $settings['extension_discovery_scan_tests'] = TRUE;

# PHP built-in webserver, started from the Drupal web root:
#   PHP_CLI_SERVER_WORKERS=8 php -S localhost:8000 .ht.router.php
# The router gives clean URLs, the workers avoid a deadlock on parallel requests.
# DRUPAL_TEST_BASE_URL='http://localhost:8000'
# DRUPAL_TEST_SETUP_FILE='modules/contrib/ui_patterns/tests/src/TestSite/PlaywrightTestSetup.php'
# DRUPAL_TEST_DB_URL=sqlite://localhost/sites/default/files/simpletest/.test_playwright.sqlite

##
# Case 2: Existing Drupal site (e.g. DDEV), no installation, tests run faster.
#
# Required modules are enabled by the tests over drush.
# Your settings.php MUST include:
# $settings['extension_discovery_scan_tests'] = TRUE;

# DRUPAL_TEST_BASE_URL='https://mysite.ddev.site'
# DRUPAL_TEST_SKIP_INSTALL=true
# DRUPAL_TEST_DRUSH_PREFIX='ddev'

##
# If the module is symlinked into the web root (e.g. from a local_packages/
# checkout), Node's cwd resolves outside the Drupal web root; point
# getRootDir() at the real web root, relative to the module's physical dir.

# DRUPAL_WEB_ROOT='../../web'

# PLAYWRIGHT_SKIP_TEARDOWN=true
# DRUPAL_TEST_WEBSERVER_USER=www-data
