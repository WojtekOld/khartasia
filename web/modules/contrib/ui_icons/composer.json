    "type": "drupal-module",
    "require-dev": {
        "drupal/link_attributes": "^2.0",
        "drupal/linkit": "^7.0",
        "drupal/ui_patterns": "^2",
        "drupal/ui_patterns_settings": "^3.0.0-alpha1",
        "weitzman/drupal-test-traits": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "drupal/core-composer-scaffold": true,
