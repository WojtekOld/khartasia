<?php

/**
 * @file
 * Contains term_glossary.module.
 */

use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FormatterInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\term_glossary\Hook\TermGlossaryHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function term_glossary_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(TermGlossaryHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function term_glossary_theme() {
  return \Drupal::service(TermGlossaryHooks::class)->theme();
}

/**
 * Implements hook_field_formatter_third_party_settings_form().
 */
#[LegacyHook]
function term_glossary_field_formatter_third_party_settings_form(FormatterInterface $plugin, FieldDefinitionInterface $field_definition, $view_mode, array $form, FormStateInterface $form_state) {
  return \Drupal::service(TermGlossaryHooks::class)->fieldFormatterThirdPartySettingsForm($plugin, $field_definition, $view_mode, $form, $form_state);
}

/**
 * Implements hook_field_formatter_settings_summary_alter().
 */
#[LegacyHook]
function term_glossary_field_formatter_settings_summary_alter(array &$summary, array $context) {
  \Drupal::service(TermGlossaryHooks::class)->fieldFormatterSettingsSummaryAlter($summary, $context);
}

/**
 * Implements hook_preprocess_field().
 */
#[LegacyHook]
function term_glossary_preprocess_field(&$variables) {
  \Drupal::service(TermGlossaryHooks::class)->preprocessField($variables);
}
