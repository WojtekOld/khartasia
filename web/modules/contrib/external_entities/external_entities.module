/**
 * Save the annotated external entity.
 *
 * Saves the external entity (if any) that the given entity is annotating. We do
 * this because annotation changes can have indirect changes to an external
 * entity.
 *
 * An example use case: an annotatable external entity is displayed (entity
 * display) along with various inherited annotation fields. Saving
 * the external entity on annotation change will make sure the render cache
 * for the external entity is invalidated and the annotation changes become
 * visible.
 *
 * Another example use case: a pathauto pattern is configured for an annotatable
 * external entity, and the pattern uses an inherited annotation field. Saving
 * the external entity on annotation change will make sure the generated path
 * is updated.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   An entity object.
 *
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function _external_entities_save_annotated_external_entity(EntityInterface $entity) {
  if (!empty($entity->{ExternalEntityInterface::ANNOTATION_AUTO_SAVE_INDUCED_BY_EXTERNAL_ENTITY_CHANGE_PROPERTY})) {
    return;
  }

  if (!$entity instanceof FieldableEntityInterface) {
    return;
  }

  // Static index of annotatable external entity types keyed by
  // "<annotation entity type>:<annotation bundle>". Building it once per
  // request instead of loading and looping over every external entity type
  // on each entity save makes saving entities that cannot be annotations
  // cost (almost) nothing, which matters for bulk operations.
  // The index is reset when an external entity type is saved or deleted.
  // @see external_entities_external_entity_type_insert()
  // @see https://www.drupal.org/project/external_entities/issues/3593699
  $annotatable_index = &drupal_static(__FUNCTION__);
  if (!isset($annotatable_index)) {
    $annotatable_index = [];
    /** @var \Drupal\external_entities\Entity\ExternalEntityTypeInterface[] $external_entity_types */
    $external_entity_types = \Drupal::entityTypeManager()
      ->getStorage('external_entity_type')
      ->loadMultiple();
    foreach ($external_entity_types as $external_entity_type) {
      if ($external_entity_type->isAnnotatable()) {
        $index_key = $external_entity_type->getAnnotationEntityTypeId()
          . ':' . $external_entity_type->getAnnotationBundleId();
        $annotatable_index[$index_key][] = $external_entity_type;
      }
    }
  }

  $index_key = $entity->getEntityTypeId() . ':' . $entity->bundle();
  if (empty($annotatable_index[$index_key])) {
    return;
  }

  /** @var \Drupal\external_entities\Entity\ExternalEntityTypeInterface $external_entity_type */
  foreach ($annotatable_index[$index_key] as $external_entity_type) {
    $annotation_field = $entity->get($external_entity_type->getAnnotationFieldName());
    $original_annotation_field = DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => $entity->getOriginal() !== NULL, fn() => isset($entity->original))
      && DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => $entity->getOriginal(), fn() => $entity->original) instanceof FieldableEntityInterface
      ? DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => $entity->getOriginal(), fn() => $entity->original)->get($external_entity_type->getAnnotationFieldName())
      : NULL;

    // Collect the external entities referenced now and, on update, the ones
    // referenced before the save: an external entity that just got
    // de-referenced must drop its annotation mapping too.
    $target_ids = array_column($annotation_field->getValue(), 'target_id');
    if ($original_annotation_field) {
      $target_ids = array_merge(
        $target_ids,
        array_column($original_annotation_field->getValue(), 'target_id')
      );
    }
    $target_ids = array_unique(array_filter($target_ids));
    if (empty($target_ids)) {
      continue;
    }

    // On update, when neither the annotation reference nor any inherited
    // field changed, the mapped annotation values of the referenced external
    // entities are unchanged as well: keep them cached. This matters for
    // bulk synchronization runs that re-save mostly unchanged entities.
    if ($original_annotation_field
      && $annotation_field->equals($original_annotation_field)
    ) {
      $inherited_field_changed = FALSE;
      foreach (array_keys($external_entity_type->getInheritedAnnotationFields()) as $field_name) {
        if ($entity->hasField($field_name)
          && !$entity->get($field_name)->equals(DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => $entity->getOriginal(), fn() => $entity->original)->get($field_name))
        ) {
          $inherited_field_changed = TRUE;
          break;
        }
      }
      if (!$inherited_field_changed) {
        continue;
      }
    }

    // The referenced external entities do not need to be re-saved: the
    // annotation values they expose are computed fields mapped at load time
    // from the annotation entity, and computed fields are excluded from the
    // raw data sent to storage clients (see ExternalEntity::toRawData()), so
    // a remote re-save would write back exactly the data that was loaded.
    // The only effect such a save had was resetting the entity cache. Do
    // just that instead: invalidate the cached external entities so their
    // next load re-maps fresh annotation values, without any remote
    // round-trip.
    \Drupal::entityTypeManager()
      ->getStorage($external_entity_type->getDerivedEntityTypeId())
      ->resetCache($target_ids);
  }
}

