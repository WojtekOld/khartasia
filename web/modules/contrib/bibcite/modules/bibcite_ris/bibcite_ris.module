<?php

/**
 * @file
 * Module hooks.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\bibcite_ris\Hook\BibciteRisHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function bibcite_ris_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(BibciteRisHooks::class)->help($route_name, $route_match);
}
