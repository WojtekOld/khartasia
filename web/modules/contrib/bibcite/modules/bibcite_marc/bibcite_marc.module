<?php

/**
 * @file
 * Module hooks.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\bibcite_marc\Hook\BibciteMarcHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function bibcite_marc_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(BibciteMarcHooks::class)->help($route_name, $route_match);
}
