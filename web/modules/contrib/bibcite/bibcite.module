<?php

/**
 * @file
 * Main module hooks.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\bibcite\Hook\BibciteHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function bibcite_theme($existing, $type, $theme, $path) {
  return \Drupal::service(BibciteHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_preprocess_HOOK().
 */
#[LegacyHook]
function bibcite_preprocess_bibcite_citation(&$variables) {
  \Drupal::service(BibciteHooks::class)->preprocessBibciteCitation($variables);
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function bibcite_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(BibciteHooks::class)->help($route_name, $route_match);
}
