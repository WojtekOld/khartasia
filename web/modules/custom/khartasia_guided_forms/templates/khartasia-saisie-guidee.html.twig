{#
  khartasia-saisie-guidee.html.twig — page « Saisie guidée ».
  Variables : vue (diagramme|liste), liens (clé => titre, aide, url|null), groupes, selecteur,
  url_diagramme, url_liste, regles.
  Un raccourci sans url est grisé (chemin introuvable ou accès refusé).
#}
{% macro boite(l, x, y, w, h, lignes, classe) %}
  {% set actif = l.url is not empty %}
  <a class="sg-boite sg-{{ classe }}{{ actif ? '' : ' is-disabled' }}"{% if actif %} href="{{ l.url }}"{% else %} aria-disabled="true"{% endif %}>
    <title>{{ l.titre }} — {{ l.aide }}{{ actif ? '' : ' (non disponible avec votre rôle)' }}</title>
    <rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" rx="6"/>
    {% for t in lignes %}
      <text x="{{ x + w / 2 }}" y="{{ y + h / 2 + (loop.index0 - (lignes|length - 1) / 2) * 17 + 5 }}" text-anchor="middle" class="{{ loop.first ? 'sg-b1' : 'sg-b2' }}">{{ t }}</text>
    {% endfor %}
  </a>
{% endmacro %}
{% import _self as sg %}

<div class="sg" data-vue="{{ vue }}">

  <p class="sg-intro">Choisissez par où commencer. Le <strong>papier</strong> est le pivot métier, la <strong>plante</strong> le pivot nomenclatural, l'<strong>attestation</strong> la charnière qui les relie : chaque affirmation est sourcée, datée, qualifiée.</p>

  <p class="sg-bascule" role="navigation" aria-label="Mode d'affichage">
    <a href="{{ url_diagramme }}" class="{{ vue == 'diagramme' ? 'is-actif' }}">Diagramme</a>
    <a href="{{ url_liste }}" class="{{ vue == 'liste' ? 'is-actif' }}">Liste</a>
  </p>

  {# ── Vue diagramme ─────────────────────────────────────────────── #}
  <div class="sg-diagramme">
    <svg viewBox="0 0 1000 600" role="group" aria-label="Diagramme cliquable de la saisie guidée" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="sg-fl" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="sg-fleche"/></marker>
      </defs>

      {# Univers papier #}
      <g class="sg-zone sg-zone--papier">
        <rect x="10" y="10" width="290" height="470" rx="10"/>
        <text x="155" y="42" text-anchor="middle" class="sg-t">UNIVERS PAPIER</text>
        <text x="155" y="62" text-anchor="middle" class="sg-s">pivot métier — le répertoire public</text>
        {{ sg.boite(liens.papier_nouveau, 30, 90, 250, 70, ['Nouveau papier', 'saisie guidée'], 'papier') }}
        {{ sg.boite(liens.nom_papier, 30, 180, 250, 70, ['Nom de papier', 'marque, terroir, exonyme…'], 'papier') }}
        {{ sg.boite(liens.zone, 30, 270, 250, 70, ['Zone historique', 'de production'], 'papier') }}
        {{ sg.boite(liens.papier_fiche, 30, 360, 250, 70, ['Fiche papier', 'formulaire complet'], 'papier') }}
      </g>

      {# Charnière #}
      <g class="sg-zone sg-zone--charniere">
        <rect x="350" y="10" width="300" height="470" rx="10"/>
        <text x="500" y="40" text-anchor="middle" class="sg-t">LA CHARNIÈRE</text>
        <text x="500" y="60" text-anchor="middle" class="sg-s sg-accent">« ce papier contient cet intrant,</text>
        <text x="500" y="76" text-anchor="middle" class="sg-s sg-accent">dans cette fonction »</text>
        <text x="500" y="94" text-anchor="middle" class="sg-s sg-accent sg-gras">= UNE AFFIRMATION, jamais un champ</text>
        {{ sg.boite(liens.attestation, 370, 115, 260, 70, ['Nouvelle attestation', 'source, sujet, objet'], 'charniere') }}
        {{ sg.boite(liens.recette, 370, 205, 260, 70, ['Recette du papier', 'saisie en série (1 source, N intrants)'], 'charniere') }}
        {{ sg.boite(liens.fonction, 370, 295, 260, 70, ["Fonctions de l'intrant", 'fibre, colorant, dispersant, adhésif…'], 'charniere') }}
        <g class="sg-note">
          <rect x="370" y="385" width="260" height="80" rx="6"/>
          <text x="500" y="415" text-anchor="middle">Vigilance « composant principal</text>
          <text x="500" y="433" text-anchor="middle">vs trace » : la mention ≠ l'usage</text>
          <text x="500" y="451" text-anchor="middle">(imprégnation, décor, parfum…)</text>
        </g>
      </g>

      {# Univers plante #}
      <g class="sg-zone sg-zone--plante">
        <rect x="700" y="10" width="290" height="290" rx="10"/>
        <text x="845" y="42" text-anchor="middle" class="sg-t">UNIVERS PLANTE</text>
        <text x="845" y="62" text-anchor="middle" class="sg-s">pivot nomenclatural</text>
        {{ sg.boite(liens.plante, 720, 80, 250, 55, ['Fiche plante', 'classification botanique'], 'plante') }}
        {{ sg.boite(liens.nom_commun, 720, 150, 250, 55, ['Noms communs', 'variantes, polysémie'], 'plante') }}
        {{ sg.boite(liens.plante_geo, 720, 220, 250, 55, ['Plante × lieu × période', 'présence attestée'], 'plante') }}
      </g>

      {# Matériaux #}
      <g class="sg-zone sg-zone--materiau">
        <rect x="700" y="320" width="290" height="160" rx="10"/>
        <text x="845" y="347" text-anchor="middle" class="sg-t">MATÉRIAUX</text>
        <text x="845" y="364" text-anchor="middle" class="sg-s">intrants non végétaux + préparations</text>
        {{ sg.boite(liens.materiau_nouveau, 720, 376, 250, 42, ['Nouveau matériau'], 'materiau') }}
        {{ sg.boite(liens.materiau_liste, 720, 428, 250, 42, ['Liste des matériaux'], 'materiau') }}
      </g>

      {# Flèches #}
      <line x1="302" y1="245" x2="346" y2="245" class="sg-trait" marker-end="url(#sg-fl)"/>
      <text x="324" y="236" text-anchor="middle" class="sg-s sg-accent">sujet</text>
      <line x1="698" y1="160" x2="654" y2="160" class="sg-trait" marker-end="url(#sg-fl)"/>
      <text x="676" y="151" text-anchor="middle" class="sg-s sg-accent">objet</text>
      <line x1="845" y1="318" x2="845" y2="302" class="sg-trait" marker-end="url(#sg-fl)"/>

      {# Référentiels #}
      <g class="sg-zone sg-zone--ref">
        <rect x="10" y="500" width="980" height="92" rx="10"/>
        <text x="500" y="525" text-anchor="middle" class="sg-t">RÉFÉRENTIELS PARTAGÉS (les trois univers)</text>
        {{ sg.boite(liens.source, 30, 540, 290, 40, ['Nouvelle source (BibCit)'], 'ref') }}
        {{ sg.boite(liens.ecritures, 355, 540, 290, 40, ['Écritures'], 'ref') }}
        {{ sg.boite(liens.aires, 680, 540, 290, 40, ['Aires culturelles'], 'ref') }}
      </g>
    </svg>
  </div>

  {# ── Vue liste ─────────────────────────────────────────────────── #}
  <div class="sg-liste">
    {% for g in groupes %}
      <section class="sg-groupe">
        <h2>{{ g.titre }}</h2>
        <p class="sg-groupe__intro">{{ g.intro }}</p>
        <ul>
          {% for cle in g.cles %}
            {% set l = liens[cle] %}
            <li class="{{ l.url ? '' : 'is-disabled' }}">
              {% if l.url %}<a href="{{ l.url }}">{{ l.titre }}</a>{% else %}<span title="Non disponible avec votre rôle">{{ l.titre }}</span>{% endif %}
              <span class="sg-aide"> — {{ l.aide }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>

  {# ── Sélecteur de papier ───────────────────────────────────────── #}
  <section id="choisir-papier" class="sg-selecteur">
    <h2>Partir d'un papier existant</h2>
    <p>Pour saisir la recette, ajouter une attestation ou retrouver le dossier d'un papier, choisissez-le d'abord.</p>
    {{ selecteur }}
  </section>

  <details class="sg-regles">
    <summary>Règles de gouvernance de la saisie</summary>
    <ol start="6">
      {% for r in regles %}<li>{{ r }}</li>{% endfor %}
    </ol>
  </details>
</div>
