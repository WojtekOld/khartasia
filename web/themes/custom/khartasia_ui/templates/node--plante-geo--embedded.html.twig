{#
/**
 * @file
 * Template pour les zones géographiques (embedded)
 */
#}
<div class="kh-geo-item">
  {% if content.field_pg_utilisation|render %}
    <div class="kh-geo__block">
      <h4 class="kh-geo__label">Utilisation</h4>
      <div class="kh-geo__content">{{ content.field_pg_utilisation }}</div>
    </div>
  {% endif %}
  
  {% if content.field_pg_culture|render %}
    <div class="kh-geo__block">
      <h4 class="kh-geo__label">Culture</h4>
      <div class="kh-geo__content">{{ content.field_pg_culture }}</div>
    </div>
  {% endif %}
  
  {% if content.field_pg_intro|render %}
    <div class="kh-geo__block">
      <h4 class="kh-geo__label">Introduction papier</h4>
      <div class="kh-geo__content">{{ content.field_pg_intro }}</div>
    </div>
  {% endif %}
  
  {% if content.field_pg_preparation|render %}
    <div class="kh-geo__block">
      <h4 class="kh-geo__label">Mode de préparation</h4>
      <div class="kh-geo__content">{{ content.field_pg_preparation }}</div>
    </div>
  {% endif %}
  
  {% if node.field_pg_source.value %}
    <div class="kh-geo__source">{{ node.field_pg_source.value }}</div>
  {% endif %}
</div>