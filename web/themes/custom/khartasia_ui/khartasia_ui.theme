<?php

/**
 * @file
 * Fonctions de préprocess pour le thème khartasia_ui.
 */

use Drupal\Core\Url;

/**
 * Implémente hook_preprocess_node().
 */
function khartasia_ui_preprocess_node(&$variables) {
  $node = $variables['node'];
  $bundle = $node->bundle();

  if ($bundle === 'article') {
    khartasia_ui_preprocess_node_article($variables, $node);
  }
  elseif ($bundle === 'papers') {
    khartasia_ui_preprocess_node_papers($variables, $node);
  }
  elseif ($bundle === 'common_names') {
    khartasia_ui_preprocess_node_common_names($variables, $node);
  }
}

/**
 * Préprocess des fiches de noms vernaculaires : quelle plante, quelle famille,
 * quels papiers, et ce que disent les sources.
 *
 * DÉFINITIONS
 * plante liée : fiche Plante (type « article ») vers laquelle pointe le nom. Un nom en
 *   vise 0 à n (champ illimité) : la polysémie, un nom pour deux plantes, en a deux.
 * portée : à quoi se rapporte un nom qui n'a PAS de plante liée (champ field_nom_portee,
 *   s'il existe) : taxon supérieur, fonction, ou sans référent papetier (faux nom).
 * attestation publiée : seule une attestation publiée est affichée. Une attestation en
 *   cours de relecture ne doit jamais apparaître sur une page publique.
 * désignation : attestation de type « Désignation » : une source affirme qu'un nom
 *   désigne tel référent (plante ou papier), à tel endroit, à telle page (locateur).
 * écriture : attestation de type « Écriture vernaculaire » : la forme graphique d'un nom.
 * locateur : localisation précise dans la source (page, planche, entrée), si le champ existe.
 */
function khartasia_ui_classer_attestations_nom(array $entrees) {
  $classees = ['ecritures' => [], 'designations' => [], 'autres' => []];
  foreach ($entrees as $e) {
    $type = $e['type_attestation'] ?? NULL;
    if ($type === 'Désignation') {
      $classees['designations'][] = $e;
    }
    elseif ($type === NULL || $type === '' || $type === 'Écriture vernaculaire') {
      // Sans type : conservé avec les écritures, comme avant ce correctif.
      $classees['ecritures'][] = $e;
    }
    else {
      $classees['autres'][] = $e;
    }
  }
  return $classees;
}

function khartasia_ui_preprocess_node_common_names(&$variables, $node) {
  $db = \Drupal::database();
  $cache_tags = ['node_list:attestation'];

  $langue_terme = $node->hasField('field_language_taxo_vern') && !$node->get('field_language_taxo_vern')->isEmpty()
    ? $node->get('field_language_taxo_vern')->entity : NULL;
  $variables['langue_nom'] = $langue_terme ? $langue_terme->label() : NULL;

  // === Plantes liées (0 à n, publiées seulement) ===
  $plantes = [];
  if ($node->hasField('field_genus_com_entity') && !$node->get('field_genus_com_entity')->isEmpty()) {
    foreach ($node->get('field_genus_com_entity')->referencedEntities() as $plante) {
      if (!$plante->isPublished()) {
        continue;
      }
      $cache_tags = array_merge($cache_tags, $plante->getCacheTags());
      $plantes[] = [
        'nid' => $plante->id(),
        'titre' => $plante->label(),
        'url' => $plante->toUrl()->toString(),
        'famille' => $plante->hasField('field_tax_family') && !$plante->get('field_tax_family')->isEmpty()
          ? $plante->get('field_tax_family')->entity->label() : NULL,
        'ordre' => $plante->hasField('field_tax_order') && !$plante->get('field_tax_order')->isEmpty()
          ? $plante->get('field_tax_order')->entity->label() : NULL,
      ];
    }
  }
  $variables['plantes_liees'] = $plantes;
  $variables['plante_liee'] = $plantes[0] ?? NULL;

  // === Portée du nom, s'il n'a pas de plante liée ===
  $variables['portee'] = NULL;
  if (!$plantes && $node->hasField('field_nom_portee') && !$node->get('field_nom_portee')->isEmpty()) {
    $definitions = [
      'taxon_superieur' => ['libelle' => 'Taxon supérieur', 'definition' => 'désigne un genre ou une famille de plantes, sans fiche Plante correspondante.'],
      'fonction' => ['libelle' => 'Appellatif générique', 'definition' => 'est un appellatif générique : il désigne une fonction ou une catégorie (par exemple « plante à papier »), pas un taxon précis.'],
      'sans_referent_papetier' => ['libelle' => 'Sans référent papetier', 'definition' => 'est rapproché de plantes à papier par certaines sources, mais aucune preuve d\'usage papetier n\'est établie.'],
    ];
    $cle = (string) $node->get('field_nom_portee')->value;
    $variables['portee'] = $definitions[$cle] ?? NULL;
  }

  // === Papiers fabriqués depuis ces plantes (publiés seulement) ===
  $tous_papiers = [];
  if ($plantes) {
    $paper_nids = $db->query("
      SELECT DISTINCT f.entity_id
      FROM node__field_genus_pap_entity f
      INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
      WHERE f.field_genus_pap_entity_target_id IN (:nids[])
      AND f.bundle = 'papers'
      AND f.deleted = 0
    ", [':nids[]' => array_column($plantes, 'nid')])->fetchCol();
    foreach (\Drupal\node\Entity\Node::loadMultiple($paper_nids) as $p) {
      $tous_papiers[] = ['titre' => $p->label(), 'url' => $p->toUrl()->toString()];
    }
  }

  // === PAGINATION PAPIERS ===
  $papiers_per_page = 10;
  $total_papiers_meme_plante = count($tous_papiers);

  $pager_cn = \Drupal::service('pager.manager')->createPager($total_papiers_meme_plante, $papiers_per_page, 0);
  $current_page_cn = $pager_cn->getCurrentPage();
  $offset_cn = $current_page_cn * $papiers_per_page;

  $variables['papiers_meme_plante'] = array_slice($tous_papiers, $offset_cn, $papiers_per_page);
  $variables['papiers_meme_plante_total'] = $total_papiers_meme_plante;
  $variables['papiers_meme_plante_pager'] = [
    '#type' => 'pager',
    '#element' => 0,
    '#quantity' => 5,
    '#tags' => ['« Premier', '‹ Précédent', 'Suivant ›', 'Dernier »'],
  ];

  // === Attestations de ce nom (publiées seulement) ===
  $att_ids = $db->query("
    SELECT DISTINCT f.entity_id
    FROM node__field_att_nom_vernaculaire f
    INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
    WHERE f.field_att_nom_vernaculaire_target_id = :nid
    AND f.bundle = 'attestation'
    AND f.deleted = 0
    ORDER BY f.entity_id
  ", [':nid' => $node->id()])->fetchCol();

  $entrees = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($att_ids) as $att) {
    $cache_tags = array_merge($cache_tags, $att->getCacheTags());

    $type_terme = $att->hasField('field_att_type') && !$att->get('field_att_type')->isEmpty()
      ? $att->get('field_att_type')->entity : NULL;
    $type_ecriture_terme = $att->hasField('field_att_type_ecriture') && !$att->get('field_att_type_ecriture')->isEmpty()
      ? $att->get('field_att_type_ecriture')->entity : NULL;
    $source = $att->hasField('field_att_source') && !$att->get('field_att_source')->isEmpty()
      ? $att->get('field_att_source')->entity : NULL;
    $lieu = $att->hasField('field_att_lieu') && !$att->get('field_att_lieu')->isEmpty()
      ? $att->get('field_att_lieu')->entity : NULL;
    $locateur = $att->hasField('field_att_locateur') && !$att->get('field_att_locateur')->isEmpty()
      ? (string) $att->get('field_att_locateur')->value : NULL;

    // Référents de l'attestation : plantes et papiers publiés.
    $referents = [];
    foreach (['field_att_plante', 'field_att_papier'] as $champ_referent) {
      if ($att->hasField($champ_referent) && !$att->get($champ_referent)->isEmpty()) {
        foreach ($att->get($champ_referent)->referencedEntities() as $r) {
          if ($r->isPublished()) {
            $referents[] = ['titre' => $r->label(), 'url' => $r->toUrl()->toString()];
          }
        }
      }
    }

    $entrees[] = [
      'nid' => $att->id(),
      'type_attestation' => $type_terme ? $type_terme->label() : NULL,
      'type' => $type_ecriture_terme ? $type_ecriture_terme->label() : ($type_terme ? $type_terme->label() : NULL),
      'valeur' => $att->get('field_att_valeur')->value ?? '',
      'statut' => $att->get('field_att_statut')->value ?? '',
      'source' => $source ? $source->label() : NULL,
      'locateur' => $locateur,
      'lieu' => $lieu ? $lieu->label() : NULL,
      'referents' => $referents,
    ];
  }

  $classees = khartasia_ui_classer_attestations_nom($entrees);
  $variables['ecritures_vernaculaires'] = $classees['ecritures'];
  $variables['designations'] = $classees['designations'];
  $variables['autres_attestations'] = $classees['autres'];

  $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'] ?? [], array_unique($cache_tags));
}

/**
 * Préprocess pour les fiches Plantes — logique inchangée depuis avant.
 */
function khartasia_ui_preprocess_node_article(&$variables, $node) {
  $db = \Drupal::database();

  // === 1. Papiers liés à cette plante ===
  $paper_nids = $db->query("
    SELECT DISTINCT f.entity_id
    FROM node__field_genus_pap_entity f
    INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
    WHERE f.field_genus_pap_entity_target_id = :nid
    AND f.bundle = 'papers'
    AND f.deleted = 0
  ", [':nid' => $node->id()])->fetchCol();

  $all_papers = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($paper_nids) as $p) {
    $origin = $p->get('field_origin_taxo')->entity;
    $country = $origin ? $origin->label() : 'Pays non spécifié';

    $all_papers[] = [
      'nid'    => $p->id(),
      'titre'  => $p->label(),
      'origin' => $country,
      'url'    => $p->toUrl()->toString(),
    ];
  }

  // === PAGINATION PAPIERS ===
  $papers_per_page = 10;
  $total_papers = count($all_papers);

  $pager = \Drupal::service('pager.manager')->createPager($total_papers, $papers_per_page, 0);
  $current_page = $pager->getCurrentPage();
  $offset = $current_page * $papers_per_page;

  $papers_paged = array_slice($all_papers, $offset, $papers_per_page);

  $papers_by_country_paged = [];
  foreach ($papers_paged as $paper) {
    $country = $paper['origin'];
    if (!isset($papers_by_country_paged[$country])) {
      $papers_by_country_paged[$country] = [];
    }
    $papers_by_country_paged[$country][] = $paper;
  }
  ksort($papers_by_country_paged);

  $variables['papers_by_country_paged'] = $papers_by_country_paged;
  $variables['papers_total'] = $total_papers;
  $variables['papers_pager'] = [
    '#type' => 'pager',
    '#element' => 0,
    '#quantity' => 5,
    '#tags' => ['« Premier', '‹ Précédent', 'Suivant ›', 'Dernier »'],
  ];

  // === 2. Noms vernaculaires ===
  $taxo_tid = $node->get('field_tax_genus')->target_id;
  $all_noms = [];

  if ($taxo_tid) {
    $nids = $db->query("
      SELECT DISTINCT f.entity_id
      FROM node__field_genus_taxo f
      INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
      WHERE f.field_genus_taxo_target_id = :tid
      AND f.bundle = 'common_names'
      AND f.deleted = 0
    ", [':tid' => $taxo_tid])->fetchCol();

    foreach (\Drupal\node\Entity\Node::loadMultiple($nids) as $cn) {
      $lang = $cn->get('field_language_taxo_vern')->entity;
      $langue = $lang ? $lang->label() : 'Langue non spécifiée';

      $all_noms[] = [
        'nid'      => $cn->id(),
        'titre'    => $cn->label(),
        'langue'   => $langue,
        'scripture'=> $cn->get('field_ver_local_scripture')->value ?? '',
        'url'      => $cn->toUrl()->toString(),
      ];
    }

    usort($all_noms, fn($a, $b) => strcmp($a['langue'], $b['langue']));

    // === PAGINATION NOMS ===
    $noms_per_page = 30;
    $total_noms = count($all_noms);

    $pager_noms = \Drupal::service('pager.manager')->createPager($total_noms, $noms_per_page, 1);
    $current_page_noms = $pager_noms->getCurrentPage();
    $offset_noms = $current_page_noms * $noms_per_page;

    $noms_paged = array_slice($all_noms, $offset_noms, $noms_per_page);

    $noms_by_langue_paged = [];
    foreach ($noms_paged as $nom) {
      $langue = $nom['langue'];
      if (!isset($noms_by_langue_paged[$langue])) {
        $noms_by_langue_paged[$langue] = [];
      }
      $noms_by_langue_paged[$langue][] = $nom;
    }
    ksort($noms_by_langue_paged);

    $variables['noms_by_langue_paged'] = $noms_by_langue_paged;
    $variables['noms_total'] = $total_noms;
    $variables['noms_pager'] = [
      '#type' => 'pager',
      '#element' => 1,
      '#quantity' => 5,
      '#tags' => ['« Premier', '‹ Précédent', 'Suivant ›', 'Dernier »'],
    ];
  }

  // === 3. Critères morphologiques (Attestation, type=critère morphologique) ===
  $ordre_criteres = [
    'Type de fibre', 'Longueur', 'Largeur', 'Parois cellulaires', 'Surface de la fibre',
    'Extrémités', 'Stries et dislocations', 'Cellules associées', 'Caractéristiques particulières',
    'Coloration Herzberg', 'Coloration Graff C',
  ];

  $att_nids = $db->query("
    SELECT DISTINCT f.entity_id
    FROM node__field_att_plante f
    INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
    WHERE f.field_att_plante_target_id = :nid
    AND f.bundle = 'attestation'
    AND f.deleted = 0
  ", [':nid' => $node->id()])->fetchCol();

  $criteres_par_nom = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($att_nids) as $att) {
    $type_term = $att->get('field_att_type')->entity;
    if (!$type_term || $type_term->label() !== 'Critère morphologique') {
      continue;
    }
    $axe_term = $att->get('field_att_axe')->entity;
    if (!$axe_term) {
      continue;
    }
    $criteres_par_nom[$axe_term->label()] = [
      'valeur' => $att->get('field_att_valeur')->value ?? '',
      'statut' => $att->get('field_att_statut')->value ?? '',
    ];
  }

  $criteres_morpho = [];
  foreach ($ordre_criteres as $nom) {
    if (isset($criteres_par_nom[$nom])) {
      $criteres_morpho[] = [
        'critere' => $nom,
        'valeur' => $criteres_par_nom[$nom]['valeur'],
        'statut' => $criteres_par_nom[$nom]['statut'],
      ];
    }
  }

  $variables['criteres_morpho'] = $criteres_morpho;

  // === Fiches plante_texte liées (remplace plante_geo comme source de la
  // section "Zones de production" — plante_geo et plante_texte portaient le
  // même contenu, dupliqué sous deux structures différentes ; plante_texte
  // est la structure consolidée retenue, plante_geo est retiré). ===
  $textes_ids = $db->query("
    SELECT DISTINCT f.entity_id
    FROM node__field_plante_ref f
    INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
    WHERE f.field_plante_ref_target_id = :nid
  ", [':nid' => $node->id()])->fetchCol();

  $textes_multilingues = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($textes_ids) as $pt) {
    $langue = $pt->hasField('field_langue_texte') && !$pt->get('field_langue_texte')->isEmpty()
      ? $pt->get('field_langue_texte')->entity->label() : $pt->label();
    $textes_multilingues[] = ['nid' => $pt->id(), 'label' => $langue];
  }
  $variables['textes_multilingues'] = $textes_multilingues;

  // === 4. Synonymes botaniques sourcés (POWO), via classification_botanique ===
  // Relation structurée existante, jamais exploitée jusqu'ici :
  // synonymes_botaniques.field_syn_nom_accepte -> classification_botanique
  // <- field_tax_genus <- cette fiche Plante
  $genus_tid = $node->hasField('field_tax_genus') ? $node->get('field_tax_genus')->target_id : NULL;
  $synonymes_powo = [];

  if ($genus_tid) {
    $syn_tids = $db->query("
      SELECT entity_id
      FROM taxonomy_term__field_syn_nom_accepte
      WHERE field_syn_nom_accepte_target_id = :tid
    ", [':tid' => $genus_tid])->fetchCol();

    foreach (\Drupal\taxonomy\Entity\Term::loadMultiple($syn_tids) as $syn) {
      $url_field = $syn->hasField('field_syn_source_url') && !$syn->get('field_syn_source_url')->isEmpty()
        ? $syn->get('field_syn_source_url')->uri
        : '';
      $synonymes_powo[] = [
        'nom' => $syn->label(),
        'type' => $syn->hasField('field_syn_type') ? ($syn->get('field_syn_type')->value ?? '') : '',
        'source' => $syn->hasField('field_syn_source') ? ($syn->get('field_syn_source')->value ?? '') : '',
        'source_url' => $url_field,
      ];
    }
  }

  // === PAGINATION SYNONYMES ===
  $synonymes_per_page = 10;
  $total_synonymes = count($synonymes_powo);

  $pager_syn = \Drupal::service('pager.manager')->createPager($total_synonymes, $synonymes_per_page, 2);
  $current_page_syn = $pager_syn->getCurrentPage();
  $offset_syn = $current_page_syn * $synonymes_per_page;

  $variables['synonymes_powo'] = array_slice($synonymes_powo, $offset_syn, $synonymes_per_page);
  $variables['synonymes_total'] = $total_synonymes;
  $variables['synonymes_pager'] = [
    '#type' => 'pager',
    '#element' => 2,
    '#quantity' => 5,
    '#tags' => ['« Premier', '‹ Précédent', 'Suivant ›', 'Dernier »'],
  ];

  // === 5. Attestations Géographie (zone_croissance) — statut sourcé,
  // distinct des zones de production plante_texte (texte libre non sourcé)
  // et de plante_geo (lat/lng, restauré séparément). ===
  $attestations_geo = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($att_nids) as $att) {
    $type_term = $att->get('field_att_type')->entity;
    if (!$type_term || $type_term->label() !== 'Géographie') {
      continue;
    }
    $lieu_term = $att->hasField('field_att_lieu') && !$att->get('field_att_lieu')->isEmpty()
      ? $att->get('field_att_lieu')->entity : NULL;
    $source_ref = $att->hasField('field_att_source') && !$att->get('field_att_source')->isEmpty()
      ? $att->get('field_att_source')->entity : NULL;
    $statut_presence_val = $att->hasField('field_att_statut_presence') && !$att->get('field_att_statut_presence')->isEmpty()
      ? $att->get('field_att_statut_presence')->value : '';

    $statut_labels = [
      'indigene' => 'Indigène', 'introduit' => 'Introduit',
      'naturalise' => 'Naturalisé', 'cultive' => 'Cultivé',
      'introduit_hybride' => 'Introduit (hybride)',
    ];

    $attestations_geo[] = [
      'lieu' => $lieu_term ? $lieu_term->label() : ($att->label() ?: 'Non localisé'),
      'statut_presence' => $statut_labels[$statut_presence_val] ?? $statut_presence_val,
      'valeur' => strip_tags($att->get('field_att_valeur')->value ?? ''),
      'source' => $source_ref ? $source_ref->label() : '',
    ];
  }
  $variables['attestations_geo'] = $attestations_geo;

  // === Nomenclature — nom accepté POWO et indicateur cultigène ===
  $variables['att_nom_accepte_powo'] = $node->hasField('field_nom_accepte_powo') && !$node->get('field_nom_accepte_powo')->isEmpty()
    ? $node->get('field_nom_accepte_powo')->value : NULL;
  $variables['att_taxon_cultigene'] = $node->hasField('field_taxon_cultigene')
    ? (bool) $node->get('field_taxon_cultigene')->value : FALSE;

}

/**
 * Préprocess pour les fiches Papiers — noms vernaculaires groupés par
 * langue, écriture locale sur la même ligne, sans étiquette de champ.
 * Remplace le rendu Vue brut (drupal_view) qui affichait les libellés
 * et dupliquait les entrées en cas de correspondance multi-genre.
 */
function khartasia_ui_preprocess_node_papers(&$variables, $node) {
  $db = \Drupal::database();

  khartasia_ui_preprocess_node_papers_attestations($variables, $node);

  // Variantes connues — relation inverse de field_variante_de : quels
  // Papiers se déclarent variantes de celui-ci (ex. Lianqi zhi → Liansi).
  $variantes_ids = $db->query("
    SELECT DISTINCT f.entity_id
    FROM node__field_variante_de f
    INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
    WHERE f.field_variante_de_target_id = :nid
  ", [':nid' => $node->id()])->fetchCol();

  if ($variantes_ids) {
    $variantes = [];
    foreach (\Drupal\node\Entity\Node::loadMultiple($variantes_ids) as $v) {
      $variantes[] = ['titre' => $v->label(), 'url' => $v->toUrl()->toString()];
    }
    $variables['papier_variantes_connues'] = $variantes;
  }

  if (!$node->hasField('field_genus_taxo_pap') || $node->get('field_genus_taxo_pap')->isEmpty()) {
    return;
  }

  $genus_tids = [];
  foreach ($node->get('field_genus_taxo_pap') as $item) {
    $genus_tids[] = $item->target_id;
  }

  $placeholders = implode(',', array_fill(0, count($genus_tids), '?'));
  $nids = $db->query("
    SELECT DISTINCT f.entity_id
    FROM node__field_genus_taxo f
    INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
    WHERE f.field_genus_taxo_target_id IN ($placeholders)
    AND f.bundle = 'common_names'
    AND f.deleted = 0
  ", $genus_tids)->fetchCol();

  if (!$nids) {
    return;
  }

  $par_langue = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($nids) as $cn) {
    $lang = $cn->hasField('field_language_taxo_vern') ? $cn->get('field_language_taxo_vern')->entity : NULL;
    $langue = $lang ? $lang->label() : 'Langue non spécifiée';

    $par_langue[$langue][] = [
      'titre' => $cn->label(),
      'scripture' => $cn->hasField('field_ver_local_scripture') ? ($cn->get('field_ver_local_scripture')->value ?? '') : '',
      'url' => $cn->toUrl()->toString(),
    ];
  }
  ksort($par_langue);

  $variables['papier_noms_par_langue'] = $par_langue;
  $variables['papier_noms_total'] = count($nids);
}

/**
 * Rassemble les Attestations d'un Papier, groupées par type (et par axe
 * quand le type est Composition), pour affichage. Couvre les types
 * construits jusqu'ici : Datation, Géographie, Composition (avec ses axes
 * Fibre principale / Colorant / Agent de traitement / Méthode de
 * fabrication / Dimension-Format).
 */
/**
 * Rassemble les Attestations d'un Papier, groupées par type (et par axe
 * quand le type est Composition), pour affichage.
 *
 * v2 — corrige un piège Drupal documenté : Url::fromRoute()->toString()
 * SANS l'argument $collect_bubbleable_metadata (donc sans le passer à
 * TRUE) génère l'URL sans capturer ses métadonnées de cache — appelé
 * depuis une fonction de preprocess (hors contexte de rendu propre), ça
 * peut déclencher un arrêt d'assertion PHP, invisible à un try/catch
 * classique selon la configuration (zend.assertions activé en dev,
 * courant sur ddev). toString(TRUE) retourne un objet GeneratedUrl dont
 * les métadonnées se fusionnent proprement dans $variables['#cache'].
 */
/**
 * Regroupe, pour un même type d'attestation, celles qui énoncent la même
 * affirmation : une attestation dont le champ réservé aux éditeurs
 * « se replie dans » pointe vers une autre attestation du même type est
 * repliée dans celle-ci, dont la ligne affiche alors toutes les sources.
 *
 * Fonction pure (ni base de données ni entités), donc testable seule.
 *
 * @param array $liste
 *   Entrées d'un même type. Chacune porte au moins 'nid', 'replie_dans'
 *   (nid cible ou NULL) et 'groupe_source' (la source de cette attestation).
 *
 * @return array
 *   Les entrées conservées, chacune avec 'sources' : la liste des groupes de
 *   source de l'entrée puis de celles qui s'y sont repliées. Une cible absente
 *   de la liste, ou une boucle, laisse l'attestation affichée normalement.
 */
function khartasia_ui_regrouper_attestations(array $liste) {
  $par_nid = [];
  foreach ($liste as $entree) {
    $par_nid[$entree['nid']] = $entree;
  }

  $cible_de = [];
  foreach ($liste as $entree) {
    $nid = $entree['nid'];
    $vus = [$nid => TRUE];
    $replie = $entree['replie_dans'] ?? NULL;
    $cible = NULL;
    $boucle = FALSE;
    while ($replie !== NULL && isset($par_nid[$replie])) {
      if (isset($vus[$replie])) {
        $boucle = TRUE;
        break;
      }
      $cible = $replie;
      $vus[$replie] = TRUE;
      $replie = $par_nid[$replie]['replie_dans'] ?? NULL;
    }
    if ($cible !== NULL && !$boucle) {
      $cible_de[$nid] = $cible;
    }
  }

  $repliees = [];
  foreach ($liste as $entree) {
    if (isset($cible_de[$entree['nid']])) {
      $repliees[$cible_de[$entree['nid']]][] = $entree['groupe_source'];
    }
  }

  $resultat = [];
  foreach ($liste as $entree) {
    if (isset($cible_de[$entree['nid']])) {
      continue;
    }
    $entree['sources'] = array_merge([$entree['groupe_source']], $repliees[$entree['nid']] ?? []);
    unset($entree['groupe_source'], $entree['replie_dans']);
    $resultat[] = $entree;
  }
  return $resultat;
}

function khartasia_ui_preprocess_node_papers_attestations(&$variables, $node) {
  $db = \Drupal::database();

  $att_ids = $db->query("
    SELECT DISTINCT f.entity_id
    FROM node__field_att_papier f
    INNER JOIN node_field_data n ON n.nid = f.entity_id AND n.status = 1
    WHERE f.field_att_papier_target_id = :nid
    AND f.bundle = 'attestation'
    AND f.deleted = 0
  ", [':nid' => $node->id()])->fetchCol();

  $attestations_par_type = [];
  $cache_tags = [];

  foreach (\Drupal\node\Entity\Node::loadMultiple($att_ids) as $att) {
    $cache_tags = array_merge($cache_tags, $att->getCacheTags());

    $type_term = $att->hasField('field_att_type') && !$att->get('field_att_type')->isEmpty()
      ? $att->get('field_att_type')->entity : NULL;
    $type_label = $type_term ? $type_term->label() : 'Non typé';

    $axe_term = $att->hasField('field_att_axe') && !$att->get('field_att_axe')->isEmpty()
      ? $att->get('field_att_axe')->entity : NULL;

    $periodes = [];
    if ($att->hasField('field_att_periode') && !$att->get('field_att_periode')->isEmpty()) {
      foreach ($att->get('field_att_periode') as $item) {
        if ($item->entity) $periodes[] = $item->entity->label();
      }
    }

    $lieu = $att->hasField('field_att_lieu') && !$att->get('field_att_lieu')->isEmpty()
      ? $att->get('field_att_lieu')->entity->label() : NULL;

    $source_label = NULL;
    if ($att->hasField('field_att_source') && !$att->get('field_att_source')->isEmpty()) {
      $source_entite = $att->get('field_att_source')->entity;
      $source_label = $source_entite ? $source_entite->label() : NULL;
    }

    $motifs = ($att->hasField('field_att_revue_motifs') && !$att->get('field_att_revue_motifs')->isEmpty())
      ? array_column($att->get('field_att_revue_motifs')->getValue(), 'value') : [];
    $a_revoir = $att->hasField('field_att_a_revoir') ? (bool) $att->get('field_att_a_revoir')->value : FALSE;

    $url_dispute = NULL;
    if (!in_array('dispute_signalee', $motifs, TRUE)) {
      try {
        $generated = \Drupal\Core\Url::fromRoute('khartasia_core.signaler_dispute', ['attestation' => $att->id()])
          ->toString(TRUE);
        $url_dispute = $generated->getGeneratedUrl();
        $cache_tags = array_merge($cache_tags, $generated->getCacheTags());
      }
      catch (\Exception $e) {
        $url_dispute = NULL;
      }
    }

    $statut = $att->get('field_att_statut')->value ?? '';
    $replie_dans = ($att->hasField('field_att_replie_dans') && !$att->get('field_att_replie_dans')->isEmpty())
      ? (int) $att->get('field_att_replie_dans')->target_id : NULL;

    $attestations_par_type[$type_label][] = [
      'nid' => $att->id(),
      'axe' => $axe_term ? $axe_term->label() : NULL,
      'valeur' => $att->get('field_att_valeur')->value ?? '',
      'statut' => $statut,
      'periodes' => $periodes,
      'lieu' => $lieu,
      'source' => $source_label,
      'a_revoir' => $a_revoir,
      'motifs' => $motifs,
      'url_dispute' => $url_dispute,
      'replie_dans' => $replie_dans,
      // Une « source » = une attestation : son libellé, son statut, et si une
      // discussion est en cours (seul motif rendu public ; les autres motifs
      // de revue, comme une source absente, restent réservés aux éditeurs).
      'groupe_source' => [
        'nid' => $att->id(),
        'label' => $source_label,
        'statut' => $statut,
        'dispute' => in_array('dispute_signalee', $motifs, TRUE),
        'url_dispute' => $url_dispute,
      ],
    ];
  }

  foreach ($attestations_par_type as $type_label => $liste) {
    $attestations_par_type[$type_label] = khartasia_ui_regrouper_attestations($liste);
  }
  ksort($attestations_par_type);

  $variables['attestations_par_type'] = $attestations_par_type;
  $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'] ?? [], array_unique($cache_tags));
}

function khartasia_ui_preprocess_html(&$variables) {
  $variables['wc_build_marker'] = NULL;
  $stamp_path = DRUPAL_ROOT . '/build-stamp.json';
  if (file_exists($stamp_path)) {
    $stamp = json_decode(file_get_contents($stamp_path), TRUE);
    if (!empty($stamp['build'])) {
      // Simple chaîne, imprimée directement par html.html.twig — plus fiable
      // que d'injecter un élément dans page_bottom dont la structure exacte
      // au moment du préprocesseur n'est pas garantie.
      $variables['wc_build_marker'] = $stamp['build'];
    }
  }
}

/**
 * Implémente hook_theme().
 */
function khartasia_ui_theme($existing, $type, $theme, $path) {
  return [
    'node__plante_fibre__embedded' => [
      'base hook' => 'node',
      'template' => 'node--plante-fibre--embedded',
      'path' => $path . '/templates',
    ],
    'node__plante_geo__embedded' => [
      'base hook' => 'node',
      'template' => 'node--plante-geo--embedded',
      'path' => $path . '/templates',
    ],
    'node__plante_texte__embedded' => [
      'base hook' => 'node',
      'template' => 'node--plante-texte--embedded',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implémente hook_preprocess_page() — fournit les compteurs réels pour la
 * page d'accueil (kh_count_plantes, kh_count_papers), jamais alimentés
 * jusqu'ici malgré leur présence dans page--front.html.twig. Limité à la
 * page d'accueil pour ne pas exécuter ces requêtes sur chaque page.
 */
function khartasia_ui_preprocess_page(&$variables) {
  if (empty($variables['is_front'])) {
    return;
  }

  $variables['kh_count_plantes'] = \Drupal::entityQuery('node')
    ->condition('type', 'article')
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->count()
    ->execute();

  $variables['kh_count_papers'] = \Drupal::entityQuery('node')
    ->condition('type', 'papers')
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->count()
    ->execute();

  // Liens de langue pour la page d'accueil — calculés directement plutôt
  // que via un bloc Drupal (deux tentatives échouées : drupal_block() et
  // drupal_entity('block', ...) donnaient toutes deux "This block is
  // broken or missing", probablement un problème de contexte de route
  // manquant lors d'un rendu forcé hors du cycle normal de la page).
  $langue_courante = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $kh_langues = [];
  foreach (\Drupal::languageManager()->getLanguages() as $langue) {
    $kh_langues[] = [
      'code' => $langue->getId(),
      'label' => $langue->getName(),
      'url' => \Drupal\Core\Url::fromRoute('<front>', [], ['language' => $langue])->toString(),
      'active' => $langue->getId() === $langue_courante,
    ];
  }
  $variables['kh_langues'] = $kh_langues;
}

/**
 * Implémente hook_language_switch_links_alter().
 * Filtre le bloc natif de changement de langue pour ne proposer que les
 * langues réellement traduites du nœud affiché — sans ce filtre, Drupal
 * liste toutes les langues activées sur le site, y compris celles
 * (coréen, chinois simplifié) qu'aucun contenu ne possède réellement,
 * menant vers des pages vides ou des redirections trompeuses.
 */
/**
 * Implémente hook_preprocess_links__language_block().
 * Filtre le bloc natif de changement de langue pour ne proposer que les
 * langues réellement traduites du nœud affiché. Remplace une première
 * tentative via hook_language_switch_links_alter(), jamais invoquée par
 * Drupal pour ce bloc (confirmé par un test en watchdog : le hook alter
 * ne se déclenche jamais) — hook_preprocess_HOOK() est le mécanisme fiable
 * déjà utilisé partout ailleurs dans ce thème.
 */
function khartasia_ui_preprocess_links__language_block(&$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');

  if (!$node instanceof \Drupal\node\NodeInterface) {
    return; // pas une page de nœud — rien à filtrer (page d'accueil, etc.)
  }

  $langues_disponibles = array_keys($node->getTranslationLanguages());

  foreach ($variables['links'] as $langcode => $lien) {
    if (!in_array($langcode, $langues_disponibles)) {
      unset($variables['links'][$langcode]);
    }
  }
}
